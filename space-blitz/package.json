{
  "name": "space-blitz",
  "version": "1.0.0",
  "description": "Modern web-based strategy game migration from Stellar Crisis",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=client\" \"npm run dev --workspace=server\"",
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "start": "concurrently \"npm run preview --workspace=client\" \"npm run start --workspace=server\"",
    "test": "npm run test --workspace=client -- --run && npm run test --workspace=server -- --run",
    "test:bdd": "cucumber-js --config cucumber.js",
    "test:e2e": "playwright test",
    "install-all": "npm install"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.0",
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.0",
    "playwright": "^1.40.0",
    "typescript": "^5.0.0"
  },
  "keywords": ["game", "strategy", "web", "react", "express"],
  "author": "",
  "license": "ISC"
}