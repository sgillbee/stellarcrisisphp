{
  "name": "space-blitz-server",
  "version": "1.0.0",
  "description": "Express server for Space Blitz game",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "setup": "node scripts/setup.js",
    "migrate": "npx tsx src/migration/index.ts",
    "seed": "npx tsx src/migration/seed.ts",
    "lint": "eslint src/**/*.ts",
    "test": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "helmet": "^6.0.0",
    "mongoose": "^7.0.0",
    "mysql2": "^3.15.3",
    "socket.io": "^4.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.45.0",
    "supertest": "^6.3.3",
    "ts-node": "^10.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "keywords": [
    "express",
    "typescript",
    "game",
    "server"
  ],
  "author": "",
  "license": "ISC"
}
